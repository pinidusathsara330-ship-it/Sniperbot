  }

  document.getElementById('statSignals').textContent = `${dailyCount.count}/${settings.maxDailySignals || 6}`;
  document.getElementById('signalProgress').style.width = `${(dailyCount.count / (settings.maxDailySignals || 6)) * 100}%`;
  document.getElementById('statWinRate').textContent = `${stats.winRate.toFixed(1)}%`;
  document.getElementById('statPnL').textContent = `$${stats.totalPnL.toFixed(2)}`;
  document.getElementById('statPnLChange').textContent = `${stats.totalPnL >= 0 ? '+' : ''}${stats.totalPnL.toFixed(2)}%`;
  document.getElementById('statPnLChange').className = `stat-change ${stats.totalPnL >= 0 ? 'positive' : 'negative'}`;

  const activePos = positions.filter(p => p.status === 'active' || p.status === 'tp1_hit' || p.status === 'tp2_hit');
  document.getElementById('statPositions').textContent = `${activePos.length}/${settings.maxPositions || 2}`;
}

function renderPositions() {
  const tbody = document.getElementById('positionsTable');
  const active = positions.filter(p => p.status === 'active' || p.status === 'tp1_hit' || p.status === 'tp2_hit');

  if (active.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: var(--text-secondary);">No active positions</td></tr>';
    return;
  }

  tbody.innerHTML = active.map(p => {
    const roi = p.roi || 0;
    const tpHit = p.tp3_hit_time ? 3 : p.tp2_hit_time ? 2 : p.tp1_hit ? 1 : 0;
    return `
      <tr>
        <td><strong>${p.symbol}</strong></td>
        <td><span class="signal-direction ${p.direction === 'LONG' ? 'direction-long' : 'direction-short'}">${p.direction}</span></td>
        <td>$${p.entry.toFixed(4)}</td>
        <td>$${(p.current_price || p.entry).toFixed(4)}</td>
        <td class="${roi >= 0 ? 'positive' : 'negative'}">${roi >= 0 ? '+' : ''}${roi.toFixed(2)}%</td>
        <td>${tpHit}/3</td>
      </tr>
    `;
  }).join('');
}

function renderHistory() {
  const tbody = document.getElementById('historyTable');
  const recent = trades.slice(-20).reverse();

  if (recent.length === 0) {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: var(--text-secondary);">No trade history</td></tr>';
    return;
  }

  tbody.innerHTML = recent.map(t => {
    const isWin = t.status === 'completed' && t.roi > 0;
    const roi = t.roi || 0;
    return `
      <tr>
        <td>${new Date(t.timestamp).toLocaleString()}</td>
        <td><strong>${t.symbol}</strong></td>
        <td><span class="signal-direction ${t.direction === 'LONG' ? 'direction-long' : 'direction-short'}">${t.direction}</span></td>
        <td>$${t.entry.toFixed(4)}</td>
        <td>$${(t.exit_price || t.current_price || t.entry).toFixed(4)}</td>
        <td><span class="card-badge ${isWin ? 'badge-green' : 'badge-red'}">${isWin ? '✅ WIN' : '❌ LOSS'}</span></td>
        <td class="${roi >= 0 ? 'positive' : 'negative'}">${roi >= 0 ? '+' : ''}${roi.toFixed(2)}%</td>
        <td>${t.confidence || 'N/A'}</td>
      </tr>
    `;
  }).join('');
}

function filterHistory(type) {
  const tbody = document.getElementById('historyTable');
  let filtered = trades.slice(-20).reverse();
  if (type === 'win') filtered = filtered.filter(t => t.status === 'completed' && t.roi > 0);
  if (type === 'loss') filtered = filtered.filter(t => t.status === 'stopped' || (t.status === 'completed' && t.roi <= 0));

  if (filtered.length === 0) {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: var(--text-secondary);">No trades found</td></tr>';
    return;
  }

  tbody.innerHTML = filtered.map(t => {
    const isWin = t.status === 'completed' && t.roi > 0;
    const roi = t.roi || 0;
    return `
      <tr>
        <td>${new Date(t.timestamp).toLocaleString()}</td>
        <td><strong>${t.symbol}</strong></td>
        <td><span class="signal-direction ${t.direction === 'LONG' ? 'direction-long' : 'direction-short'}">${t.direction}</span></td>
        <td>$${t.entry.toFixed(4)}</td>
        <td>$${(t.exit_price || t.current_price || t.entry).toFixed(4)}</td>
        <td><span class="card-badge ${isWin ? 'badge-green' : 'badge-red'}">${isWin ? '✅ WIN' : '❌ LOSS'}</span></td>
        <td class="${roi >= 0 ? 'positive' : 'negative'}">${roi >= 0 ? '+' : ''}${roi.toFixed(2)}%</td>
        <td>${t.confidence || 'N/A'}</td>
      </tr>
    `;
  }).join('');
}

function renderSignals() {
  const container = document.getElementById('signalsContainer');
  const recent = signals.slice(-5).reverse();

  if (recent.length === 0) {
    container.innerHTML = `
      <div style="text-align: center; padding: 40px; color: var(--text-secondary);">
        <div style="font-size: 48px; margin-bottom: 16px;">📡</div>
        <p>Scanning markets for sniper signals...</p>
        <p style="font-size: 12px; margin-top: 8px;">Start the bot to begin trading</p>
      </div>`;
    return;
  }

  container.innerHTML = recent.map(s => `
    <div class="card signal-card" style="margin-bottom: 12px;">
      <div class="signal-header">
        <span class="signal-symbol">${s.symbol}</span>
        <span class="signal-direction ${s.direction === 'LONG' ? 'direction-long' : 'direction-short'}">${s.direction === 'LONG' ? '🟢 BUY' : '🔴 SELL'} ${s.direction}</span>
      </div>
      <div style="margin-bottom: 8px;">
        <span class="card-badge ${s.confidence === 'SNIPER' ? 'badge-gold' : s.confidence === 'HIGH' ? 'badge-green' : 'badge-red'}">${s.confidence}</span>
        <span style="color: var(--text-secondary); font-size: 12px; margin-left: 8px;">${s.reason}</span>
      </div>
      <div class="signal-details">
        <div class="detail-item"><span class="detail-label">Entry</span><span class="detail-value">$${s.entry.toFixed(4)}</span></div>
        <div class="detail-item"><span class="detail-label">SL</span><span class="detail-value" style="color: var(--accent-red);">$${s.sl.toFixed(4)}</span></div>
        <div class="detail-item"><span class="detail-label">TP1</span><span class="detail-value" style="color: var(--accent);">$${s.tp1.toFixed(4)}</span></div>
        <div class="detail-item"><span class="detail-label">TP2</span><span class="detail-value" style="color: var(--accent);">$${s.tp2.toFixed(4)}</span></div>
        <div class="detail-item"><span class="detail-label">TP3</span><span class="detail-value" style="color: var(--accent);">$${s.tp3.toFixed(4)}</span></div>
        <div class="detail-item"><span class="detail-label">RSI</span><span class="detail-value">${s.rsi}</span></div>
        <div class="detail-item"><span class="detail-label">Size</span><span class="detail-value">$${s.positionSize ? s.positionSize.toFixed(2) : '0.00'}</span></div>
        <div class="detail-item"><span class="detail-label">Liq</span><span class="detail-value" style="color: var(--accent-red);">$${s.liqPrice ? s.liqPrice.toFixed(2) : '--'}</span></div>
      </div>
      <div style="font-size: 12px; color: var(--text-secondary); margin-top: 8px;">
        ${new Date(s.timestamp).toLocaleString()}
      </div>
    </div>
  `).join('');
}

// ================= UI HELPERS =================
function showModal(id) {
  document.getElementById(id).classList.add('active');
}

function hideModal(id) {
  document.getElementById(id).classList.remove('active');
}

function switchTab(tabId) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  event.target.classList.add('active');
  document.getElementById(tabId).classList.add('active');
}

function showToast(message, type = 'success') {
  const toast = document.getElementById('toast');
  document.getElementById('toastIcon').textContent = type === 'error' ? '❌' : '✅';
  document.getElementById('toastMessage').textContent = message;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 3000);
}

// Close modals on overlay click
document.querySelectorAll('.modal-overlay').forEach(overlay => {
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) overlay.classList.remove('active');
  });
});

// ================= INIT =================
window.addEventListener('DOMContentLoaded', () => {
  const saved = localStorage.getItem('sniper_current_user');
  if (saved) {
    currentUser = JSON.parse(saved);
    showDashboard();
  }
});
</script>
