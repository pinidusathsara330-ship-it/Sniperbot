async function startTradingBot() {
  if (botRunning) return;

  if (!settings.apiKey || !settings.secretKey) {
    showToast('❌ Please configure Binance API keys first!', 'error');
    showModal('settingsModal');
    switchTab('tab-api');
    return;
  }

  const balance = await getBinanceBalance();
  if (balance === null && settings.tradingMode === 'real') {
    showToast('❌ Cannot connect to Binance. Check API keys.', 'error');
    return;
  }

  const actualBalance = balance !== null ? balance : settings.baseCapital;
  if (actualBalance < 7) {
    showToast('❌ Minimum $7 USDT required to trade!', 'error');
    return;
  }

  botRunning = true;
  document.getElementById('btnStartBot').classList.add('hidden');
  document.getElementById('btnStopBot').classList.remove('hidden');
  document.getElementById('botStatusIndicator').className = 'bot-status bot-running';
  document.getElementById('botStatusDot').textContent = '🟢';
  document.getElementById('botStatusText').textContent = 'Bot Running';

  showToast('🚀 Trading Bot Started!');
  updateBalanceDisplay(actualBalance);

  botInterval = setInterval(scanAndTrade, 30000);
  scanAndTrade();
  priceUpdateInterval = setInterval(updatePositionPrices, 5000);
}

function stopTradingBot() {
  botRunning = false;
  if (botInterval) clearInterval(botInterval);
  if (priceUpdateInterval) clearInterval(priceUpdateInterval);

  document.getElementById('btnStartBot').classList.remove('hidden');
  document.getElementById('btnStopBot').classList.add('hidden');
  document.getElementById('botStatusIndicator').className = 'bot-status bot-stopped';
  document.getElementById('botStatusDot').textContent = '🔴';
  document.getElementById('botStatusText').textContent = 'Bot Stopped';

  showToast('⏹️ Trading Bot Stopped');
}

async function scanAndTrade() {
  if (!botRunning) return;

  const today = new Date().toISOString().split('T')[0];
  if (dailyCount.date !== today) {
    dailyCount = { count: 0, date: today };
    dailyLoss = 0;
    localStorage.setItem('sniper_daily', JSON.stringify(dailyCount));
  }

  if (dailyCount.count >= settings.maxDailySignals) {
    showToast('📅 Daily trade limit reached (' + settings.maxDailySignals + ')');
    stopTradingBot();
    return;
  }

  const now = Date.now();
  const cooldownMs = settings.cooldown * 60 * 1000;
  if (now - lastTradeTime < cooldownMs) return;

  const activePos = positions.filter(p => p.status === 'active' || p.status === 'tp1_hit' || p.status === 'tp2_hit');
  if (activePos.length >= settings.maxPositions) return;

  const balance = await getBinanceBalance() || settings.baseCapital;
  if (balance < 7) {
    showToast('❌ Insufficient balance!', 'error');
    stopTradingBot();
    return;
  }

  // Scan selected coins
  const coins = settings.selectedCoins || ['BTCUSDT', 'ETHUSDT'];
  let bestSignal = null;
  let bestConfluence = 0;

  for (const symbol of coins) {
    try {
      const signal = await analyzeSymbol(symbol);
      if (signal && signal.confluence > bestConfluence) {
        bestSignal = signal;
        bestConfluence = signal.confluence;
      }
    } catch (e) {
      console.error('Scan error for', symbol, e);
    }
  }

  if (bestSignal) {
    // Update liquidation display
    updateLiquidationDisplay(bestSignal);

    // Place order
    const orderResult = await placeBinanceOrder(bestSignal, balance);
    if (orderResult) {
      bestSignal.orderId = orderResult.orderId;
      bestSignal.status = 'active';
      bestSignal.current_price = bestSignal.entry;
      bestSignal.roi = 0;
      bestSignal.tp1_hit = false;
      bestSignal.tp2_hit = false;
      bestSignal.tp3_hit = false;

      signals.push(bestSignal);
      positions.push(bestSignal);

      localStorage.setItem('sniper_signals', JSON.stringify(signals));
      localStorage.setItem('sniper_positions', JSON.stringify(positions));

      dailyCount.count++;
      lastTradeTime = Date.now();
      localStorage.setItem('sniper_daily', JSON.stringify(dailyCount));

      renderSignals();
      updateStats();
      renderPositions();

      showToast(`🎯 SNIPER SIGNAL: ${bestSignal.symbol} ${bestSignal.direction} @ $${bestSignal.entry.toFixed(2)}`);

      // Send Telegram
      if (settings.telegramToken && settings.chatId) {
        sendTelegramSignal(bestSignal);
      }
    }
  }

  updateBalanceDisplay(balance);
}

async function updatePositionPrices() {
  if (!currentUser) return;

  const activePositions = positions.filter(p => p.status === 'active' || p.status === 'tp1_hit' || p.status === 'tp2_hit');
  if (activePositions.length === 0) return;

  for (const pos of activePositions) {
    try {
      const price = await getSymbolPrice(pos.symbol);
      if (price) {
        pos.current_price = price;
        pos.roi = pos.direction === 'LONG' 
          ? ((price - pos.entry) / pos.entry) * 100 
          : ((pos.entry - price) / pos.entry) * 100;

        // Check TP hits
        if (!pos.tp1_hit && pos.direction === 'LONG' && price >= pos.tp1) {
          pos.tp1_hit = true; pos.status = 'tp1_hit';
          showToast(`🎯 TP1 HIT: ${pos.symbol} +${(pos.roi).toFixed(2)}%`);
          if (settings.telegramToken) sendTelegramTP(pos, 1);
        }
        if (!pos.tp2_hit && pos.direction === 'LONG' && price >= pos.tp2) {
          pos.tp2_hit = true; pos.status = 'tp2_hit';
          showToast(`🎯 TP2 HIT: ${pos.symbol} +${(pos.roi).toFixed(2)}%`);
          if (settings.telegramToken) sendTelegramTP(pos, 2);
        }
        if (pos.direction === 'LONG' && price >= pos.tp3) {
          closePosition(pos, 'tp3');
          continue;
        }

        if (!pos.tp1_hit && pos.direction === 'SHORT' && price <= pos.tp1) {
          pos.tp1_hit = true; pos.status = 'tp1_hit';
          showToast(`🎯 TP1 HIT: ${pos.symbol} +${(pos.roi).toFixed(2)}%`);
          if (settings.telegramToken) sendTelegramTP(pos, 1);
        }
        if (!pos.tp2_hit && pos.direction === 'SHORT' && price <= pos.tp2) {
          pos.tp2_hit = true; pos.status = 'tp2_hit';
          showToast(`🎯 TP2 HIT: ${pos.symbol} +${(pos.roi).toFixed(2)}%`);
          if (settings.telegramToken) sendTelegramTP(pos, 2);
        }
        if (pos.direction === 'SHORT' && price <= pos.tp3) {
          closePosition(pos, 'tp3');
          continue;
        }

        // Check SL
        if (pos.direction === 'LONG' && price <= pos.sl) {
          closePosition(pos, 'sl');
          continue;
        }
        if (pos.direction === 'SHORT' && price >= pos.sl) {
          closePosition(pos, 'sl');
          continue;
        }

        // Check liquidation (emergency)
        const liqDistance = Math.abs(price - pos.liqPrice) / pos.entry;
        if (liqDistance < 0.005) {
          closePosition(pos, 'liq');
          showToast(`🚨 LIQUIDATION WARNING CLOSED: ${pos.symbol}`, 'error');
          continue;
        }
      }
    } catch (e) {
      console.error('Price update error:', e);
    }
  }

  localStorage.setItem('sniper_positions', JSON.stringify(positions));
  renderPositions();
  updateStats();
}

function closePosition(pos, reason) {
  pos.status = 'completed';
  pos.exit_price = pos.current_price;
  pos.exit_reason = reason;
  pos.exit_time = new Date().toISOString();

  const pnl = pos.direction === 'LONG' 
    ? ((pos.exit_price - pos.entry) / pos.entry) * 100 
    : ((pos.entry - pos.exit_price) / pos.entry) * 100;
  pos.roi = pnl;

  const isWin = pnl > 0;
  stats.total++;
  if (isWin) stats.wins++; else stats.losses++;
  stats.winRate = stats.total > 0 ? (stats.wins / stats.total) * 100 : 0;
  stats.totalPnL += pnl;

  if (!isWin) {
    dailyLoss += Math.abs(pnl);
  }

  trades.push({
    symbol: pos.symbol,
    direction: pos.direction,
    entry: pos.entry,
    exit_price: pos.exit_price,
    status: isWin ? 'completed' : 'stopped',
    roi: pnl,
    confidence: pos.confidence,
    timestamp: pos.exit_time,
    reason: reason
  });

  localStorage.setItem('sniper_stats', JSON.stringify(stats));
  localStorage.setItem('sniper_trades', JSON.stringify(trades));
  localStorage.setItem('sniper_positions', JSON.stringify(positions));

  renderPositions();
  renderHistory();
  updateStats();

  const emoji = reason === 'tp3' ? '🚀' : reason === 'sl' ? '⛔' : '🚨';
  showToast(`${emoji} Position closed: ${pos.symbol} ${pnl >= 0 ? '+' : ''}${pnl.toFixed(2)}%`);

  if (settings.telegramToken) {
    sendTelegramClose(pos, reason, pnl);
  }

  // Stop bot if max daily loss reached
  if (dailyLoss >= settings.maxDailyLoss) {
    showToast(`🛑 Max daily loss (${settings.maxDailyLoss}%) reached!`, 'error');
    stopTradingBot();
  }
}

